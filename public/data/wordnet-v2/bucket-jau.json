onyms":[]},"jaunty":{"word":"jaunty","partOfSpeech":"adjective","definitions":[{"definition":"having a cheerful, lively, and self-confident air"},{"definition":"marked by up-to-dateness in dress and manners"}],"synonyms":["chipper","debonair","debonaire","dapper","dashing","natty","raffish","rakish"],"antonyms":[]},"jauntily":{"word":"jauntily","partOfSpeech":"adverb","definitions":[{"definition":"in a jaunty fashionable manner"}],"synonyms":[],"antonyms":[]}}